{
  "schema_version": 1,
  "suite_glob": "plugins/tdd-playbook/tests/test_*.py",
  "acknowledged_roster_sha256": "4c226b0f56b69590b4861efcc95ab79f39fea2de0aebe1d48bcdc9c47d4878ce",
  "acknowledged_plan_sha256": "50de29dcae2b21f758014178bcb646e7cf4b4f904a5d554bf599c9f67577095c",
  "fixed_stages": [
    {
      "id": "calibration",
      "argv": [
        "python3",
        "calibration/test_harness.py"
      ]
    },
    {
      "id": "dataflow",
      "argv": [
        "python3",
        "plugins/tdd-playbook/bin/dataflow_sweeps.py",
        "all",
        "--config",
        "dataflow-sweeps.json"
      ]
    },
    {
      "id": "ledger",
      "argv": [
        "python3",
        "calibration/ledger.py",
        "check",
        "--baseline-rev",
        "{ledger_base}"
      ]
    },
    {
      "id": "plant-forms",
      "argv": [
        "python3",
        "calibration/plant_forms.py",
        "check"
      ]
    }
  ],
  "force_full": [
    ".github/workflows/gate.yml",
    "AGENTS.md",
    "CLAUDE.md",
    "calibration/ledger.py",
    "calibration/plant_forms.py",
    "calibration/test_harness.py",
    "capabilities.json",
    "dataflow-sweeps.json",
    "docs/architecture/host-parity-policy.json",
    "docs/architecture/host-parity.json",
    "docs/reference/current-state.md",
    "docs/reviews/**",
    "gate-manifest.json",
    "plugins/tdd-playbook/bin/dataflow_sweeps.py",
    "plugins/tdd-playbook/bin/gate_plan.py",
    "plugins/tdd-playbook/bin/gate_runner.py",
    "plugins/tdd-playbook/bin/host_parity.py",
    "plugins/tdd-playbook/bin/mutation_run.py",
    "plugins/tdd-playbook/bin/render_agents.py",
    "plugins/tdd-playbook/bin/render_reference.py",
    "plugins/tdd-playbook/bin/reset_plan.py",
    "plugins/tdd-playbook/bin/review_ledger.py",
    "plugins/tdd-playbook/bin/vendoring.py",
    "plugins/tdd-playbook/tests/test_aaa_suites_via_main.py",
    "scripts/civerd_gate.sh",
    "scripts/install_into_repo.py"
  ],
  "safe_rules": [
    {
      "patterns": [
        "AGENTS.md",
        "CLAUDE.md"
      ],
      "suites": [
        "test_agents"
      ]
    },
    {
      "patterns": [
        "plugins/tdd-playbook/bin/host_contract.py"
      ],
      "suites": [
        "test_portable_core",
        "test_host_adapters",
        "test_host_doctor",
        "test_codex_adapter",
        "test_red_lock_portable",
        "test_tdd_lock",
        "test_installer"
      ]
    },
    {
      "patterns": [
        "plugins/tdd-playbook/bin/tdd.py"
      ],
      "suites": [
        "test_host_doctor",
        "test_codex_adapter",
        "test_vendoring"
      ]
    },
    {
      "patterns": [
        "plugins/tdd-playbook/bin/tdd_lock.py"
      ],
      "suites": [
        "test_tdd_lock",
        "test_host_adapters",
        "test_portable_core"
      ]
    },
    {
      "patterns": [
        "plugins/tdd-playbook/adapters/**"
      ],
      "suites": [
        "test_codex_adapter",
        "test_host_adapters",
        "test_installer",
        "test_host_parity"
      ]
    },
    {
      "patterns": [
        "plugins/tdd-playbook/hooks/**"
      ],
      "suites": [
        "test_hooks",
        "test_host_adapters",
        "test_tdd_lock",
        "test_red_lock_portable",
        "test_installer",
        "test_host_parity"
      ]
    },
    {
      "patterns": [
        "scripts/install_into_repo.py"
      ],
      "suites": [
        "test_installer",
        "test_host_parity",
        "test_vendoring"
      ]
    },
    {
      "patterns": [
        "docs/architecture/host-parity*.json"
      ],
      "suites": [
        "test_host_parity",
        "test_installer"
      ]
    },
    {
      "patterns": [
        "README.md",
        "docs/architecture/**",
        "docs/reference/**"
      ],
      "suites": [
        "test_reference_docs"
      ]
    }
  ]
}
