{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test_lock_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: test-lock guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/snapshot_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: snapshot guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/fixture_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: fixture-data guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test_lock_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: test-lock guard (shell)"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/snapshot_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: snapshot guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/tag_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: release-tag guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/exitcode_guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/fixture_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: fixture-data guard (shell)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/test_weakening_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: test-weakening guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/flaky_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: flaky-pattern guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/overmock_guard.py\"",
            "timeout": 15,
            "statusMessage": "TDD: over-mock guard"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/red_lock.py\"",
            "timeout": 15,
            "statusMessage": "TDD: red-lock tracker"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/exhaustive_claim_guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/red_lock.py\"",
            "timeout": 15,
            "statusMessage": "TDD: red-lock (auto-lock on red)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/intent_nudge.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture.py\" --event UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/build_completion_reminder.py\"",
            "timeout": 15,
            "statusMessage": "TDD: Tripwire reminder"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture.py\" --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
